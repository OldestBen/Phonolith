# ─── Library ────────────────────────────────────────────────────────────────
# Absolute path to your local music library
LIBRARY_PATH=/path/to/your/music

# ─── Worker Pool ────────────────────────────────────────────────────────────
# CPU cores to allocate for analysis (Prism, Crest, Bit-Forge)
WORKER_POOL_SIZE=4

# ─── Ports ──────────────────────────────────────────────────────────────────
API_PORT=8000
UI_PORT=3000

# ─── Last.fm ────────────────────────────────────────────────────────────────
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USERNAME=

# ─── MusicBrainz ────────────────────────────────────────────────────────────
# Required: identify your application
MUSICBRAINZ_USER_AGENT=Phonolith/0.1.0 (your@email.com)

# ─── Discogs ────────────────────────────────────────────────────────────────
DISCOGS_TOKEN=

# ─── Plex / Tautulli ────────────────────────────────────────────────────────
PLEX_URL=
PLEX_TOKEN=

# ─── Aegis — S3-compatible Vaulting ─────────────────────────────────────────
# Supports AWS S3, Backblaze B2, Cloudflare R2, Wasabi
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=phonolith-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Enable S3 Object Lock (WORM) — requires compatible bucket config
S3_OBJECT_LOCK=false
# Retention days for immutable backups
S3_RETENTION_DAYS=365

# ─── AirPlay (Flux) ─────────────────────────────────────────────────────────
AIRPLAY_RECEIVER_NAME=Phonolith

# ─── Polyphony — Syndicate Peering ──────────────────────────────────────────
# Your node alias, shown to peers
POLYPHONY_NODE_ALIAS=my-phonolith-node
