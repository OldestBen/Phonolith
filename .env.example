# Required
GENIUS_ACCESS_TOKEN=

# Database (set automatically in Docker Compose)
DATABASE_URL=postgresql://phonolith:phonolith@localhost:5432/phonolith

# Redis (set automatically)
REDIS_URL=redis://localhost:6379

# Analyst sidecar URL
ANALYST_URL=http://localhost:8000

# Optional enrichment
MUSICBRAINZ_APP_NAME=Phonolith
MUSICBRAINZ_APP_VERSION=1.0
MUSICBRAINZ_CONTACT=your@email.com
DISCOGS_USER_TOKEN=
ACOUSTID_API_KEY=

# Optional S3 backup
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Library path (mounted into analyst container)
# Leave blank to use ./music relative to the project root (Docker Desktop compatible)
LIBRARY_PATH=

# Port configuration (change if you have conflicts)
APP_PORT=3000
ANALYST_PORT=8000
# DB_PORT=5432       # uncomment docker-compose.yml db.ports to use
# REDIS_PORT=6379    # uncomment docker-compose.yml redis.ports to use
