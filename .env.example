# ── Required ───────────────────────────────────────────────────────────────────
GENIUS_ACCESS_TOKEN=

# ── Session cookies ───────────────────────────────────────────────────────────
# Set to "true" only if you access Phonolith exclusively over HTTPS.
# Leaving this unset (or "false") is correct for localhost / plain-HTTP LAN access.
# If "true", Safari and other browsers will refuse to send the session cookie over
# HTTP, causing every API call to return 401.
COOKIE_SECURE=

# ── Credential encryption ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting SMB/NFS credentials at rest.
# Generate with: openssl rand -hex 32
# If unset, a fallback derived from DATABASE_URL is used — not for production.
CREDENTIAL_KEY=

# ── Database (set automatically in Docker Compose) ─────────────────────────────
DATABASE_URL=postgresql://phonolith:phonolith@localhost:5432/phonolith

# ── Redis (set automatically) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Sidecar URLs (set automatically in Docker Compose) ────────────────────────
ANALYST_URL=http://localhost:8000
LUCID_URL=http://localhost:8001

# ── MusicBrainz (no API key required — identify your instance) ────────────────
# Required by MusicBrainz fair-use policy.
MUSICBRAINZ_APP_NAME=Phonolith
MUSICBRAINZ_APP_VERSION=1.0
MUSICBRAINZ_CONTACT=your@email.com

# ── Optional enrichment ────────────────────────────────────────────────────────
DISCOGS_USER_TOKEN=
ACOUSTID_API_KEY=

# ── Optional S3 backup ─────────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Optional Soulcatcher (Soulseek search/download via slskd) ─────────────────
# Your Soulseek network credentials — any client (including slskd) needs an
# account on the Soulseek network itself. Leave both blank to leave Soulcatcher
# disabled; the slskd sidecar will idle and /api/soulcatcher/status will report
# it offline.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
# Optional: protects slskd's own REST API with an API key (sent by the app as
# the X-API-Key header). Leave blank to use slskd unauthenticated on the
# internal Docker network only — fine for local/LAN use, but set this if you
# ever expose slskd directly.
SLSKD_API_KEY=

# ── Optional remote access ─────────────────────────────────────────────────────
# Tailscale: join this instance to your private tailnet (zero-config remote access,
# no port forwarding). Generate an auth key at https://login.tailscale.com/admin/settings/keys
# Leave blank to skip — the tailscale sidecar stays idle without it.
TAILSCALE_AUTHKEY=
# Cloudflare Tunnel: expose this instance through Cloudflare's edge (good for sharing
# without revealing your home IP). Create a tunnel and copy its token from the
# Cloudflare Zero Trust dashboard (Networks → Tunnels). Leave blank to skip.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Library path ───────────────────────────────────────────────────────────────
# Mounted read-only into both analyst and lucid containers.
# Leave blank to use ./music relative to the project root.
LIBRARY_PATH=

# ── Port configuration ─────────────────────────────────────────────────────────
# HTTP_PORT is the one to open in your browser — Caddy routes media streams
# and the realtime transport socket straight to Lucid and everything else to
# the app, so it must be the single entry point (not APP_PORT).
HTTP_PORT=8080
HTTPS_PORT=8443
APP_PORT=3000
ANALYST_PORT=8000
LUCID_PORT=8001
# DB_PORT=5432       # uncomment docker-compose.yml db.ports to use

# ── HTTPS (optional) ───────────────────────────────────────────────────────────
# Leave blank for plain HTTP on HTTP_PORT (LAN / no domain). Set to a real,
# publicly-resolvable domain (e.g. music.example.com) to have Caddy
# automatically obtain and renew a Let's Encrypt certificate and serve HTTPS.
SITE_ADDRESS=
# REDIS_PORT=6379    # uncomment docker-compose.yml redis.ports to use
