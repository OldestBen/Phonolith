# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in your values:   cp .env.example .env
#
# REQUIRED variables must be set before `docker compose up` will work.
# Everything else is optional and has a working default.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Library path (optional) ─────────────────────────────────────────────────
# Absolute path on the Docker host where your music files live.
# Mounted read-only at /library inside Tremor and analysis containers.
# Leave blank to boot without a local library — you can add sources later
# via the Sources page in the UI, or use Phonolith in analytics-only mode
# (connect Last.fm / Plex in Settings to populate the dashboard).
LIBRARY_PATH=


# ─── Ports ───────────────────────────────────────────────────────────────────
API_PORT=8000    # REST API + WebSocket gateway  →  http://localhost:8000
UI_PORT=3000     # Web UI                        →  http://localhost:3000


# ─── Worker pools ────────────────────────────────────────────────────────────
# Parallel threads for CPU-bound work (hashing, DR scoring, spectral analysis,
# semantic embedding, opus transcoding, waveform rendering).
# Good starting point: half your physical core count.
WORKER_POOL_SIZE=4


# ─── Last.fm ─────────────────────────────────────────────────────────────────
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USERNAME=
# How often to check for new scrobbles (hours). Default: 6.
LASTFM_SYNC_INTERVAL_HOURS=6


# ─── MusicBrainz ─────────────────────────────────────────────────────────────
# Identify your instance — required by the MusicBrainz API terms of service.
MUSICBRAINZ_USER_AGENT=Phonolith/0.1.0 (your@email.com)


# ─── Discogs ─────────────────────────────────────────────────────────────────
DISCOGS_TOKEN=


# ─── Plex ────────────────────────────────────────────────────────────────────
PLEX_URL=http://localhost:32400
PLEX_TOKEN=
# How often to poll Plex for new plays and rating changes (hours). Default: 1.
PLEX_SYNC_INTERVAL_HOURS=1


# ─── Aegis — S3-compatible vaulting ──────────────────────────────────────────
# Supports AWS S3, Backblaze B2, Cloudflare R2, Wasabi, MinIO.
# Leave S3_BUCKET empty to disable Aegis entirely.
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# S3 Object Lock / WORM retention in days.  0 = disabled.
WORM_RETENTION_DAYS=0

# SurePlay re-verification cadence (hours) and random-sample size.
SUREPLAY_INTERVAL_HOURS=720
SUREPLAY_SAMPLE_SIZE=50


# ─── AirPlay (Flux) ──────────────────────────────────────────────────────────
# Name advertised over mDNS — visible to Apple devices on your LAN.
AIRPLAY_RECEIVER_NAME=Phonolith


# ─── Polyphony — Syndicate peer mesh ─────────────────────────────────────────
# Alias for this node, shown to trusted peers.
POLYPHONY_NODE_ALIAS=my-phonolith-node


# ─── S.M.A.R.T. drive monitoring ─────────────────────────────────────────────
# Comma-separated block devices to monitor.  Leave empty for auto-detect.
# The `smart` service must run privileged (already set in docker-compose.yml).
# Example: SMART_DEVICES=/dev/sda,/dev/sdb,/dev/nvme0
SMART_DEVICES=

# Poll interval in seconds (default: 1 hour).
SMART_POLL_INTERVAL_SECS=3600
